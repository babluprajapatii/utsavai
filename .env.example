# ============================================================================
# UtsavAI - Environment Configuration Example
# ============================================================================

# Supabase Public Configuration (Accessible in browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Privileged Secret (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini AI (Server-side planning assistant)
GEMINI_API_KEY=your-gemini-api-key

# Legacy Local DB URL (Preserved for backward compatibility until complete migration)
DATABASE_URL=file:./db/custom.db

